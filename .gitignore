# Virtual environment
venv/
.env/
.env
.venv/

# Secrets (MC#939): real config lives ONLY in untracked env files.
# The committed template is config/scan_pro.env.example (placeholders only).
# The engine now lives under source/, so cover both locations.
config/*.env
!config/scan_pro.env.example
source/config/*.env
!source/config/scan_pro.env.example

